# Local application
APP_ENV=development
APP_BASE_URL=http://localhost:8080
HTTP_ADDR=:8080
LOG_LEVEL=debug
STATIC_DIR=web/dist
MIGRATIONS_DIR=db/migrations
HTTP_BODY_LIMIT_BYTES=1048576
READINESS_TIMEOUT=1s
SHUTDOWN_TIMEOUT=15s

# Local database. Docker Compose overrides the hostname inside containers.
DATABASE_URL=postgres://keebhub:keebhub@localhost:54329/keebhub?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m

# Session and Discord OAuth. Credentials may stay empty for public-only local development.
SESSION_COOKIE_NAME=keebhub_session
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8080/auth/discord/callback

# Docker Compose host bindings and development database credentials.
APP_PORT=8080
POSTGRES_PORT=54329
POSTGRES_DB=keebhub
POSTGRES_USER=keebhub
POSTGRES_PASSWORD=keebhub

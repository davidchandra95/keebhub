{
  "name": "@keebhub/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=10.34.1 <11"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "docs:check": "node ../scripts/check-docs.mjs && redocly lint --config ../redocly.yaml ../api/openapi.yaml",
    "lint": "oxlint src vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@astryxdesign/core": "0.3.0",
    "@astryxdesign/theme-neutral": "0.3.0",
    "@stylexjs/stylex": "0.19.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.3.0",
    "@redocly/cli": "2.46.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "oxlint": "1.77.0",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
